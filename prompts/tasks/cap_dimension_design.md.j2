  "规范条文": {
    "墩柱直径": "30m跨：0–15m墩高1.4m，15–25m1.6m，25–35m1.8m；40m跨相应增大0.2m。",
    "墩柱间距": "中心距为柱径的2.5~3.5倍，且不小于3.5m。",
    "盖梁尺寸": "宽度2.0~2.4m，高度1.6~1.8m（连续墩可至2.0~2.4m）。",
    "支座边缘距": "0.35~0.50m，控制盖梁总长。",
    "悬臂长度": "1.1~1.3m，与支座边缘距相近。",
    "桩基直径": "30m跨1.6~2.0m，40m跨1.8~2.2m。",
    "承台厚度": "2.0~2.8m。"
  },
  "构造要求": {
    "设计逻辑": [
      "盖梁长度需满足 L = (支座数-1)*支座间距 + 左右两侧支座边缘距离 计算。",
      "盖梁长度应小于桥面宽度。",
      "桥型先映射为结构类型，再用于与样本库 system_type 进行匹配。",
      "当前阶段仅对桥墩分组进行尺寸设计，桥台分组应单独列出并说明跳过原因。"
    ]
  },
  "当前任务": {
    "任务说明": "根据输入的单联尺寸设计输入，对该联内全部桥墩分组（中间墩与边墩/连接墩）生成下部结构尺寸设计方案，不包含桥台设计；不得遗漏连接墩（边墩），并输出各桥墩与尺寸方案之间的映射关系。",
